<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="geral.css">
  <script src="https://unpkg.com/feather-icons"></script>
  <title>Cadastrar Produto</title>
</head>
<body>
  <header>
    <div class="top-header">
        <div class="topbar-fixed" role="navigation">
          <div class="topbar-container">
            <div class="topbar-header">
              <button type="button" class="topbar-toggle" data-toggle="collapse" data-target=".topbar-collapse">
                <span class="topbar-bar"></span>
              </button>
              <div class="small-logo-container">
                <a class="small-logo" href="/home">PrintStock</a>
              </div>
            </div>
            <div class="topbar-collapse collapse">
              <ul class="topbar-nav">
                <li><a href="/sair" onclick="return confirm('Tem certeza que deseja sair do sistema?')">Sair</a></li>
              </ul>
            </div>
          </div>
        </div>
    <div class="sidebar" id="sidebar">
      <nav class="navbar">
        <ul class="navbar__menu">
          <li class="navbar__item">
            <a href="/perfil" class="navbar__link"><i data-feather="user"></i><span>Perfil</span></a>        
          </li>     
          <li class="navbar__item">
            <a href="/home" class="navbar__link"><i data-feather="home"></i><span>Home</span></a>
          </li>
          <li class="navbar__item">
            <a href="/impressoras" class="navbar__link"><i data-feather="printer"></i><span>Impressoras</span></a>        
          </li>
          <li class="navbar__item">
            <a href="/suprimentos" class="navbar__link"><i data-feather="droplet"></i><span>Suprimentos</span></a>        
          </li>
          <li class="navbar__item">
            <a href="/pecas" class="navbar__link"><i data-feather="cpu"></i><span>Peças</span></a>        
          </li>
          <li class="navbar__item">
            <a href="/equipamentos" class="navbar__link"><i data-feather="package"></i><span>Equipamentos</span></a>        
          </li>
          <li class="navbar__item">
            <a href="/cadastrar_produto" class="navbar__link"><i data-feather="file-plus"></i><span>Cadastrar Produto</span></a>        
          </li>
        </ul>
      </nav>
    </div>
</header>
<div class="content">
  <h1>CADASTRAR PRODUTO</h1>
    <section class="formulario">
        <div class="box">
            <div class="form-box">
                <form method="post" id="form">
                  <div class="input-grid">
                    <div class="input-group">
                      <input type="text" name="codigo" id="codigo" placeholder=" " required>
                      <label for="codigo">Código</label>
                    </div>
                    <div class="input-group">
                      <input type="text" name="nome" id="nome" placeholder=" " required>
                      <label for="nome">Nome</label>
                    </div>
                    <div class="input-group">
                      <select name="tipo" id="tipo" required>
                        <option value="" disabled selected> </option>
                        <option value="Suprimento">Suprimento</option>
                        <option value="Impressora">Impressora</option>
                        <option value="Peça">Peça</option>
                        <option value="Equipamento">Equipamento</option>
                      </select>
                      <label for="tipo">Tipo</label>
                    </div>
                    <div class="input-group">
                      <select name="tecnologia" id="tecnologia" required> 
                        <option value="" disabled selected> </option>
                        <option value="Impressora Laser">Impressora Laser</option>
                        <option value="Impressora Jato">Impressora Jato</option>
                        <option value="Toner Pó">Toner</option>
                        <option value="Toner Cilindro">Cilindro</option>
                        <option value="Tinta Corante">Tinta Corante</option>
                        <option value="Tinta Pigmentada">Tinta Pigmentada</option>
                        <option value="Tinta Sublimática">Tinta Sublimática</option>
                        <option value="Outro">Outro</option>
                      </select>
                      <label for="tecnologia">Tecnologia</label>
                    </div>
                    <div class="input-group">
                      <select name="categoria" id="categoria" required>
                        <option value="" disabled selected> </option>
                        <option value="Original">Original</option>
                        <option value="Compatível">Compatível</option>
                        <option value="Monocromática">Monocromática</option>
                        <option value="Color">Color</option>
                        <option value="Outro">Outro</option>
                      </select>
                      <label for="categoria">Categoria</label>
                    </div>
                    <div class="input-group">
                      <select name="estado" id="estado" required>
                        <option value="" disabled selected> </option>
                        <option value="Novo">Novo</option>
                        <option value="Seminovo">Seminovo</option>
                        <option value="Recarga">Recarga</option>
                        <option value="Locação">Locação</option>
                        <option value="Sucata">Sucata</option>
                      </select>
                      <label for="estado">Estado</label>
                    </div>
                    <div class="input-group">
                      <input type="number" name="quantidade" id="quantidade" placeholder=" " required>
                      <label for="quantidade">Quantidade</label>
                    </div>
                    <div class="input-group">
                      <input type="number" name="qtde_min" id="qtde_min" placeholder=" " required>
                      <label for="qtde_min">Estoque Mínimo</label>
                    </div>
                  </div>
                
                  <div class="button-group">
                    <button type="submit" class="btn-cadastrar">Cadastrar</button>
                  </div>
                </form>
                
            </div>
        </div>
    </section>
</div>
  <script>
    feather.replace();

    document.querySelectorAll('.input-group select').forEach(select => {
    const parent = select.parentElement;
    
    const updateClass = () => {
      if (select.value !== '') {
        parent.classList.add('has-value');
      } else {
        parent.classList.remove('has-value');
      }
    };

    updateClass();
    select.addEventListener('change', updateClass);
  });

  const mapeamento = {
    Suprimento: {
      TonerPó: ["Original", "Compatível", "Novo", "Recarga", "Locação"],
      TonerCilindro: ["Original", "Compatível", "Novo", "Recarga", "Locação"],
      TintaCorante: ["Original", "Compatível", "Novo", "Recarga", "Locação"],
      TintaPigmentada: ["Original", "Compatível", "Novo", "Recarga", "Locação"],
      TintaSublimática: ["Original", "Compatível", "Novo", "Recarga", "Locação"]
    },
    Impressora: {
      ImpressoraLaser: ["Monocromática", "Color", "Novo", "Seminovo", "Sucata"],
      ImpressoraJato: ["Monocromática", "Color", "Novo", "Seminovo", "Sucata"]
    },
    Peça: {
      ImpressoraLaser: ["Monocromática", "Color", "Novo", "Seminovo"],
      ImpressoraJato: ["Monocromática", "Color", "Novo", "Seminovo"],
      TonerPó: ["Monocromática", "Color", "Novo", "Seminovo"],
      TonerCilindro: ["Monocromática", "Color", "Novo", "Seminovo"],
      Outro: ["Outro", "Novo", "Seminovo"]
    },
    Equipamento: {
      Outro: ["Outro", "Novo", "Seminovo", "Sucata"]
    }
  };

  const selects = {
    tipo: document.getElementById("tipo"),
    tecnologia: document.getElementById("tecnologia"),
    categoria: document.getElementById("categoria"),
    estado: document.getElementById("estado")
  };

  const disableSelect = (select) => {
    select.selectedIndex = 0;
    select.disabled = true;
  };

  const enableSelect = (select) => {
    select.disabled = false;
  };

  const resetOptions = (select, validOptions) => {
    Array.from(select.options).forEach(opt => {
      if (!opt.value || validOptions.includes(opt.value)) {
        opt.hidden = false;
        opt.disabled = false;
      } else {
        opt.hidden = true;
        opt.disabled = true;
      }
    });
    select.selectedIndex = 0;
  };

  disableSelect(selects.tecnologia);
  disableSelect(selects.categoria);
  disableSelect(selects.estado);

  selects.tipo.addEventListener("change", () => {
    const tipo = selects.tipo.value;
    const tecnologias = Object.keys(mapeamento[tipo] || {}).map(t => {
      return {
        "TonerPó": "Toner Pó",
        "TonerCilindro": "Toner Cilindro",
        "TintaCorante": "Tinta Corante",
        "TintaPigmentada": "Tinta Pigmentada",
        "TintaSublimática": "Tinta Sublimática",
        "ImpressoraLaser": "Impressora Laser",
        "ImpressoraJato": "Impressora Jato",
        "Outro": "Outro"
      }[t];
    });

    resetOptions(selects.tecnologia, tecnologias);
    enableSelect(selects.tecnologia);
    disableSelect(selects.categoria);
    disableSelect(selects.estado);
  });

  selects.tecnologia.addEventListener("change", () => {
    const tipo = selects.tipo.value;
    let tecnologia = selects.tecnologia.value;

    const mapKey = {
      "Toner Pó": "TonerPó",
      "Toner Cilindro": "TonerCilindro",
      "Tinta Corante": "TintaCorante",
      "Tinta Pigmentada": "TintaPigmentada",
      "Tinta Sublimática": "TintaSublimática",
      "Impressora Laser": "ImpressoraLaser",
      "Impressora Jato": "ImpressoraJato",
      "Outro": "Outro"
    };

    const categoriaEstado = mapeamento[tipo]?.[mapKey[tecnologia]] || [];

    const categorias = categoriaEstado.filter(cat => ["Original", "Compatível", "Monocromática", "Color", "Outro"].includes(cat));
    resetOptions(selects.categoria, categorias);
    enableSelect(selects.categoria);
    disableSelect(selects.estado);
  });

  selects.categoria.addEventListener("change", () => {
    const tipo = selects.tipo.value;
    let tecnologia = selects.tecnologia.value;
    const mapKey = {
      "Toner Pó": "TonerPó",
      "Toner Cilindro": "TonerCilindro",
      "Tinta Corante": "TintaCorante",
      "Tinta Pigmentada": "TintaPigmentada",
      "Tinta Sublimática": "TintaSublimática",
      "Impressora Laser": "ImpressoraLaser",
      "Impressora Jato": "ImpressoraJato",
      "Outro": "Outro"
    };

    const categoriaEstado = mapeamento[tipo]?.[mapKey[tecnologia]] || [];
    const estados = categoriaEstado.filter(est => ["Novo", "Seminovo", "Recarga", "Locação", "Sucata"].includes(est));
    resetOptions(selects.estado, estados);
    enableSelect(selects.estado);
  });
  </script>
</body>
</html>
