<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="geral.css">
  <title>Peças</title>
</head>
<body>
  <header>
    <div class="top-header">
        <div class="menu-icon" onclick="toggleMenu()">&#9776;</div>
        <img src="logo-vazada.png" alt="" width="80px">
        <a href="/sair" class="logout"><img src="sair-icon.png" alt="" width="28px" onclick="return confirm('Tem certeza que deseja sair?')"></a>
    </div>
    <nav class="sidebar" id="sidebar">
        <ul>
            <li><img src="perfil-icon.png" alt="Ícone de perfil" width="30px"><a href="/perfil"><span class="menu-text">PERFIL</span></a></li>
            <li><img src="home-icon.png" alt="Ícone de home" width="30px"><a href="/home"><span class="menu-text">HOME</span></a></li>
            <li><img src="impressora-icon.png" alt="Ícone de impressoras" width="30px"><a href="/impressoras"><span class="menu-text">IMPRESSORAS</span></a></li>
            <li><img src="suprimentos-icon.png" alt="Ícone de suprimentos" width="30px"><a href="/suprimentos"><span class="menu-text">SUPRIMENTOS</span></a></li>
            <li><img src="pecas-icon.png" alt="Ícone de peças" width="30px"><a href="/pecas"><span class="menu-text">PEÇAS</span></a></li>
            <li><img src="equipamentos-icon.png" alt="Ícone de equipamentos" width="30px"><a href="/equipamentos"><span class="menu-text">EQUIPAMENTOS</span></a></li>
            <li><img src="cadastro-icon.png" alt="Ícone de cadastro" width="30px"><a href="/cadastrar_produto"><span class="menu-text">CADASTRAR PRODUTO</span></a></li>
        </ul>
    </nav>
</header>
<div class="content">
  <main>
    <div id="modal" class="modal">
        <div class="modal-content">
          <span class="close-button" onclick="closeModal()">&times;</span>
          <h2>Dados do Produto</h2>
          <div id="employee-data"></div>
          <div class="qtd-controls">
            <button onclick="alterarQuantidade(-1)">-</button>
            <input type="number" id="input-qtd" value="0" oninput="atualizarQuantidadeDigitada()" style="width: 60px; text-align: center;">
            <button onclick="alterarQuantidade(1)">+</button>
            <span id="qtd-atual">0</span>
          </div>
          <div style="margin-top: 10px;">
            <button id="confirm-button" onclick="confirmarAlteracao()" style="display: none;">Confirmar Alteração</button>
          </div>          
        </div>
      </div>
    <div class="content">
        <h1>PEÇAS</h1>
        <table>
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nome</th>
                    <th>Tipo</th>
                    <th>Quantidade</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                <% Produtos.forEach(function(produto) { %>
                    <% if (produto.tipo === 'Peça') { %>
                      <tr>
                          <td><%= produto.codigo %></td>
                          <td><%= produto.nome %></td>
                          <td><%= produto.tipo %></td>
                          <td><%= produto.quantidade %></td>
                          <td>
                              <a href="#" class="btn-edit">
                                  <img src="editar-icon.png" alt="Editar" width="30px">
                              </a>
                              <a href="#" onclick="openModal({
                                  _id: '<%= produto._id %>',
                                  codigo: '<%= produto.codigo %>',
                                  nome: '<%= produto.nome %>',
                                  tipo: '<%= produto.tipo %>',
                                  estado: '<%= produto.estado %>',
                                  tecnologia: '<%= produto.tecnologia %>',
                                  categoria: '<%= produto.categoria %>',
                                  quantidade: Number('<%= produto.quantidade %>'),
                              }); return false;" class="btn-delete">
                                  <img src="view-icon.png" alt="Visualizar" width="30px">
                              </a>
                          </td>
                      </tr>
                    <% } %>
                  <% }) %>
                  
            </tbody>
        </table>
    </div>
  </main>
</div>
<script>
    let produtoAtual = null;
    let alteracaoQuantidade = 0;
  
    function toggleMenu() {
      const sidebar = document.getElementById('sidebar');
      const content = document.querySelector('.content');
      sidebar.classList.toggle('active');
      content.classList.toggle('active');
    }
  
    function openModal(produto) {
      produtoAtual = produto;
      alteracaoQuantidade = 0;
  
      document.getElementById('employee-data').innerHTML = `
        <p><strong>Código:</strong> ${produto.codigo}</p>
        <p><strong>Nome:</strong> ${produto.nome}</p>
        <p><strong>Tipo:</strong> ${produto.tipo}</p>
        <p><strong>Estado:</strong> ${produto.estado}</p>
        <p><strong>Tecnologia:</strong> ${produto.tecnologia}</p>
        <p><strong>Categoria:</strong> ${produto.categoria}</p>
        <p><strong>Quantidade:</strong> ${produto.quantidade}</p>
      `;
  
      document.getElementById('qtd-atual').innerText = alteracaoQuantidade;
      document.getElementById('confirm-button').style.display = 'none';
      document.getElementById('modal').style.display = 'block';
    }
  
    function closeModal() {
      document.getElementById('modal').style.display = 'none';
    }
  
    function atualizarQuantidadeDigitada() {
  const input = document.getElementById('input-qtd');
  const valor = parseInt(input.value, 10);

  if (!isNaN(valor) && produtoAtual) {
    const novaQtd = Number(produtoAtual.quantidade) + valor;
    if (novaQtd >= 0) {
      alteracaoQuantidade = valor;
    } else {
      input.value = -produtoAtual.quantidade;
      alteracaoQuantidade = -produtoAtual.quantidade;
    }
    document.getElementById('qtd-atual').innerText = alteracaoQuantidade;
    document.getElementById('confirm-button').style.display = alteracaoQuantidade !== 0 ? 'inline-block' : 'none';
  }
}

function alterarQuantidade(valor) {
  const input = document.getElementById('input-qtd');
  const atual = parseInt(input.value, 10) || 0;
  let novoValor = atual + valor;

  if (produtoAtual && (produtoAtual.quantidade + novoValor) >= 0) {
    input.value = novoValor;
    atualizarQuantidadeDigitada();
  }
}
  
    async function confirmarAlteracao() {
  if (!produtoAtual || alteracaoQuantidade === 0) return;

  const novaQuantidade = Number(produtoAtual.quantidade) + Number(alteracaoQuantidade);

  if (novaQuantidade < 0) {
    alert("Não é possível retirar mais itens do que há em estoque.");
    return;
  }

  const confirmacao = confirm(`Tem certeza que deseja ${alteracaoQuantidade > 0 ? 'adicionar' : 'retirar'} ${Math.abs(alteracaoQuantidade)} itens?`);
  if (!confirmacao) return;

  try {
    const response = await fetch(`/atualizar_quantidade/${produtoAtual._id}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ quantidade: novaQuantidade })
    });

    const data = await response.json();
    if (data.success) {
      alert('Quantidade atualizada com sucesso!');
      location.reload();
    } else {
      alert('Erro ao atualizar a quantidade.');
    }
  } catch (err) {
    alert('Erro de comunicação com o servidor.');
    console.error(err);
  }
}

  </script>
  
</body>
</html>